{
  "name": "campus-recruit-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "职航 · 大学生校招助手：官网校招搜索与地区筛选、多模板简历工坊、投递进度看板",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --no-warnings --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "export:static": "node --no-warnings scripts/export-static-data.mjs",
    "sync:snapshot": "node --no-warnings scripts/sync-live-ats-snapshot.mjs",
    "build:pages": "npm run export:static && vite build --mode pages",
    "start": "node --no-warnings server/index.js",
    "preview": "vite preview",
    "test": "node --no-warnings --test server/tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.14",
    "vite": "^6.2.0"
  }
}
